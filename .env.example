# =============================================================================
# CMT Fleet Transit — environment template
# Copy to apps/web/.env.local (or repo-root .env.local) and fill values.
# NEVER commit real secrets. Run: pnpm check-secrets
# See: docs/architecture/integration-map.md
# =============================================================================

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# --- Firebase Auth (Phone / LINE) — client ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# --- Firebase Admin — server only ---
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Paste PEM with literal \n escaped as \\n in a single line, or use a multiline .env loader
FIREBASE_ADMIN_PRIVATE_KEY=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role bypasses RLS — server / migrations only; never ship to the browser
SUPABASE_SERVICE_ROLE_KEY=
# Optional alias used by some CLI / package paths
SUPABASE_URL=

# --- Google Maps ---
# Client key: restrict by HTTP referrer in Google Cloud Console
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Server key: Distance Matrix / Directions — restrict by IP
GOOGLE_MAPS_API_KEY=

# --- LINE Login / LIFF (platform OAuth) ---
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
NEXT_PUBLIC_LINE_LIFF_ID=

# --- Notifications ---
# FCM: use Firebase Admin for server send; VAPID above for client registration
# LINE Messaging API + Telegram bot tokens are stored per organization in the DB
# (organizations.line_channel_access_token, organizations.telegram_bot_token)

# --- Optional: monitoring / analytics ---
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=
