{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowJs": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "incremental": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@cmt/shared": ["packages/shared/src"],
      "@cmt/shared/*": ["packages/shared/src/*"],
      "@cmt/auth": ["packages/auth/src"],
      "@cmt/auth/*": ["packages/auth/src/*"],
      "@cmt/storage": ["packages/storage/src"],
      "@cmt/storage/*": ["packages/storage/src/*"],
      "@cmt/routing": ["packages/routing/src"],
      "@cmt/routing/*": ["packages/routing/src/*"],
      "@cmt/notifications": ["packages/notifications/src"],
      "@cmt/notifications/*": ["packages/notifications/src/*"]
    }
  },
  "exclude": ["node_modules", ".next", "dist", "build", "coverage"]
}
